{
  "name": "sync-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "mobile:web": "npm run web --workspace=apps/mobile",
    "mobile:android": "npm run android --workspace=apps/mobile",
    "mobile:ios": "npm run ios --workspace=apps/mobile",
    "shared:build": "npm run build --workspace=packages/shared",
    "shared:test": "npm run test --workspace=packages/shared",
    "lint": "npm run lint --workspace=apps/mobile",
    "typecheck": "npm run typecheck --workspace=apps/mobile && npm run typecheck --workspace=packages/shared"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
